# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Discord bot token (Developer Portal -> Bot -> Reset Token)
TOKEN=

# Discord server where slash commands are synced
GUILD_ID=1228025729183383685

# Google service-account key, as a single-line JSON string.
# The service account's email needs Viewer access to the sheet.
CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Google Sheet the bot reads leaderboards from
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/<sheet-id>/edit

# Postgres. docker compose sets DATABASE_URL for the bot container itself;
# this value is for running the bot or scripts directly on your machine
# against the compose database (docker compose up -d db).
POSTGRES_PASSWORD=astra_dev
DATABASE_URL=postgresql://astra:astra_dev@localhost:5432/astra

# After each data job, write the leaderboards back to GOOGLE_SHEET_URL
# (Donations, War Stats tabs). Needs Editor access for the service account.
# Set to false for a test bot that shouldn't touch the live sheet.
SHEETS_EXPORT=true

# Data kept in Postgres: the current month plus DATA_RETENTION_MONTHS before
# it, never earlier than DATA_START_MONTH. Older data is deleted daily.
DATA_RETENTION_MONTHS=2
DATA_START_MONTH=2026-10

# Optional: a channel where every leader action (joined, promoted, removed,
# linked, ...) is posted. Right-click the channel -> Copy Channel ID.
# LOG_CHANNEL_ID=

# Optional: footer icon for every embed. Leave empty to use the bot's avatar
# (recommended: Discord attachment links expire).
# FOOTER_ICON_URL=

# Optional: override the ClashKing API base URL
# CLASHKING_BASE_URL=https://api.clashk.ing
